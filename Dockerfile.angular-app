# ============================================
# Angular K-pop Hub — Multi-stage Docker Build
# ============================================
# Build Context：monorepo 根目錄（Zeabur 預設從根目錄 build）
# 使用 ZBPACK_DOCKERFILE_NAME=angular-app 觸發
# ============================================

# ---- Stage 1: Builder ----
FROM node:20-slim AS builder

WORKDIR /app

# 安裝 pnpm（與 monorepo 的 packageManager 對齊）
RUN npm install -g pnpm@9 --force

# 複製 workspace 設定檔（利用 Docker layer cache）
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./

# 複製 angular-app 的 package.json（供 pnpm 解析 workspace 依賴）
COPY apps/angular-app/package.json ./apps/angular-app/

# 安裝依賴（只安裝 angular-app 需要的部分）
RUN pnpm install --filter=@interview/angular-app... --frozen-lockfile

# 複製源碼
COPY apps/angular-app/ ./apps/angular-app/

# 執行 Angular AOT 編譯（production 模式）
RUN pnpm --filter=@interview/angular-app build

# ---- Stage 2: Serve ----
FROM nginx:alpine AS production

# 複製 builder stage 產生的靜態檔案
COPY --from=builder /app/apps/angular-app/dist/angular-app /usr/share/nginx/html

# 複製 nginx 設定（SPA routing 支援）
COPY apps/angular-app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
